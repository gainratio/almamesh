{
  "name": "@almamesh/llm",
  "version": "0.0.1",
  "license": "MIT",
  "description": "In-browser, privacy-redacted OpenAI-compatible LLM narration for AlmaMesh (no backend)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./layman-jargon": {
      "types": "./src/layman-jargon.ts",
      "import": "./src/layman-jargon.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "bench": "bun bench/src/run.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@almamesh/browser": "workspace:*",
    "@almamesh/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
