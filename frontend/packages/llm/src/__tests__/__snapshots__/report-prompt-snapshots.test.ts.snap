sal","formation_rules":[{"description":"Vimala: the 12th lord Venus placed in the 8th (dusthana)","houses":[8,12],"planets":["venus"],"rule":"vipareeta.vimala","source":"UK: Vipareeta Raja Yoga (Harsha/Sarala/Vimala - dusthana lords in dusthanas)"}],"grade":"weak","houses_involved":[8,12],"max_favorable":3,"max_unfavorable":3,"name":"Vipareeta Raja Yoga","net_marks":-1,"planetary_signature":"venus_h8_h12","planets_involved":["venus"],"strength_factors":[{"basis":"Sign dignity per the BPHS exaltation/own-sign doctrine","factor_type":"dignity","mark":0,"planet":"venus","value":"neutral"},{"basis":"Whole-sign house class from the lagna (kendra/trikona/upachaya/dusthana)","factor_type":"house_class","mark":-1,"planet":"venus","value":"dusthana (house 8)"},{"basis":"Asta (combustion) within the classical orb of the Sun (Surya-Siddhanta tradition; B.V. Raman, Graha and Bhava Balas)","factor_type":"combustion","mark":-1,"planet":"venus","value":"combust (5.61 deg from the Sun)"},{"basis":"Vakra (retrograde) motion confers high cheshta-bala (BPHS, Shadbala adhyaya)","factor_type":"retrograde","mark":1,"planet":"venus","value":"retrograde"}],"strength_pct":33.33,"strength_tier":"structural"}],"navamsa":{"lagna_sign":"Gemini","lagna_sign_lord":"mercury","name":"D9","planets":{"jupiter":{"is_combust":false,"name":"jupiter","sign":"Sagittarius","sign_lord":"jupiter"},"ketu":{"is_combust":false,"name":"ketu","sign":"Aquarius","sign_lord":"saturn"},"mars":{"is_combust":false,"name":"mars","sign":"Aquarius","sign_lord":"saturn"},"mercury":{"is_combust":false,"name":"mercury","sign":"Virgo","sign_lord":"mercury"},"moon":{"is_combust":false,"name":"moon","sign":"Scorpio","sign_lord":"mars"},"rahu":{"is_combust":false,"name":"rahu","sign":"Leo","sign_lord":"sun"},"saturn":{"is_combust":true,"name":"saturn","sign":"Scorpio","sign_lord":"mars"},"sun":{"is_combust":false,"name":"sun","sign":"Capricorn","sign_lord":"saturn"},"venus":{"is_combust":true,"name":"venus","sign":"Pisces","sign