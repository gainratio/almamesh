{
  "name": "@almamesh/browser",
  "version": "0.0.1",
  "license": "MIT",
  "description": "In-browser local-first AlmaMesh engine: standalone edge-proc signed-bundle sync plus AlmaMesh Pyodide chart compute, entirely on-device.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "node integration/parity.mjs",
    "test:parity-rectify": "node integration/rectification-precision.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@edgeproc/assay": "0.5.0-dev.3",
    "@edgeproc/avow": "0.1.1",
    "@edgeproc/browser": "github:hseshadr/edgeproc-browser#02171df60afc8b09d6439112ea7ea3202338d46a",
    "pyodide": "^0.29.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~5.7.3",
    "vitest": "^5.0.1"
  }
}
