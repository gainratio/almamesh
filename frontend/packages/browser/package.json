{
  "name": "@almamesh/browser",
  "version": "0.0.1",
  "license": "MIT",
  "description": "In-browser local-first AlmaMesh engine: standalone edge-proc signed-bundle sync plus AlmaMesh Pyodide chart compute, entirely on-device.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "node integration/parity.mjs",
    "test:parity-rectify": "node integration/rectification-precision.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gainratio/assay": "0.5.0-dev.6",
    "@gainratio/avow": "^0.5.2",
    "@gainratio/browser": "^0.3.1",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
