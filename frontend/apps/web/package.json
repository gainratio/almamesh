    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-prerender-plugin": "^0.5.14",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1",
    "wrangler": "4.146.0"
  }
