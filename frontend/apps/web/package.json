{
  "name": "@almamesh/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode dev",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:prod": "tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "serve": "bunx serve dist -l ${PORT:-3000}",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test:e2e:ai": "playwright test --config=playwright.ai-settings.config.ts",
    "test:e2e:interp": "playwright test --config=playwright.interpretation.config.ts",
    "test:e2e:interp:real": "playwright test --config=playwright.interpretation.real.config.ts",
    "test:e2e:interp:heal:real": "playwright test --config=playwright.interpretation.heal.real.config.ts",
    "test:e2e:dashboard:agentic:real": "playwright test --config=playwright.dashboard.agentic.real.config.ts",
    "test:e2e:chat:rag:real": "playwright test --config=playwright.chat.rag.real.config.ts",
    "test:e2e:chat:grounding": "playwright test --config=playwright.chat.grounding.config.ts",
    "test:e2e:rectification": "playwright test --config=playwright.rectification.config.ts",
    "test:e2e:wizard": "playwright test --config=playwright.wizard-phase2.config.ts",
    "test:e2e:report:pdf": "playwright test --config=playwright.report-pdf.config.ts",
    "test:e2e:dual-voice": "playwright test --config=playwright.dual-voice-life-atlas.config.ts",
    "test:e2e:mesh": "playwright test --config=playwright.mesh-this-is-me.config.ts",
    "test:e2e:portable-sqlite": "playwright test --config=playwright.portable-sqlite.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "data:cities": "node ../../scripts/generate-cities.mjs",
    "report:pdf:sample": "node --import tsx scripts/render-report-pdf.mjs",
    "test:e2e:returning-visitor": "playwright test --config=playwright.returning-visitor.config.ts",
    "test:e2e:sw-update": "playwright test --config=playwright.sw-update.config.ts",
    "test:e2e:live-smoke": "playwright test --config=playwright.live-smoke.config.ts"
  },
  "dependencies": {
    "@almamesh/browser": "workspace:*",
    "@almamesh/constants": "workspace:*",
    "@almamesh/llm": "workspace:*",
    "@almamesh/memory": "workspace:*",
    "@almamesh/shared-types": "workspace:*",
    "@almamesh/store": "workspace:*",
    "@assistant-ui/react": "0.15.21",
    "@edgeproc/errors": "^0.1.1",
    "@edgeproc/receipt-ui": "0.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.2",
    "@react-pdf/renderer": "^4.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.3.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.172.0",
    "tz-lookup": "6.1.25",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@edgeproc/avow": "0.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.172.0",
    "@types/tz-lookup": "6.1.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "all-the-cities": "3.1.0",
    "autoprefixer": "^10.5.4",
    "countries-list": "3.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "satori": "^0.26.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-prerender-plugin": "^0.5.13",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1",
    "wrangler": "4.103.0"
  }
}
